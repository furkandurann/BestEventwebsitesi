# Best Event - Apache Configuration for React SPA
# Natro Hosting uyumlu - 2026 Google Standards

# ============================================
# MIME Types
# ============================================
AddType image/avif .avif
AddType image/webp .webp
AddType application/javascript .js
AddType text/css .css
AddType application/json .json
AddType font/woff2 .woff2
AddType font/woff .woff

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Force Non-WWW
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Remove trailing slash (non-root)
  RewriteCond %{REQUEST_URI} .+/$
  RewriteCond %{REQUEST_URI} !^/$
  RewriteCond %{REQUEST_URI} !\.\w+$
  RewriteRule ^(.+)//?$ /$1 [R=301,L]

  # ============================================
  # Pre-compressed file serving (Brotli > Gzip)
  # ============================================
  RewriteCond %{HTTP:Accept-Encoding} br
  RewriteCond %{REQUEST_URI} ^/assets/
  RewriteCond %{REQUEST_FILENAME}.br -f
  RewriteRule ^(.+)\.(js|css|svg|json)$ $1.$2.br [E=no-gzip:1,L]

  RewriteCond %{HTTP:Accept-Encoding} gzip
  RewriteCond %{REQUEST_URI} ^/assets/
  RewriteCond %{REQUEST_FILENAME}.gz -f
  RewriteRule ^(.+)\.(js|css|svg|json)$ $1.$2.gz [E=no-gzip:1,L]

  # ============================================
  # SEO 301 Redirects
  # ============================================
  RewriteRule ^organizasyonlar/sihirbaz-kiralama/([a-z0-9-]+)$ /organizasyonlar/magic-show/$1 [R=301,L]
  RewriteRule ^organizasyonlar/sihirbaz-kiralama$ /organizasyonlar/magic-show [R=301,L]
  RewriteRule ^organizasyonlar/sihirbaz$ /organizasyonlar/magic-show [R=301,L]
  RewriteRule ^organizasyonlar/bubble-show-kiralama/([a-z0-9-]+)$ /organizasyonlar/bubble-show/$1 [R=301,L]
  RewriteRule ^organizasyonlar/bubble-show-kiralama$ /organizasyonlar/bubble-show [R=301,L]
  RewriteRule ^organizasyonlar/profesyonel-yuz-boyama/([a-z0-9-]+)$ /organizasyonlar/yuz-boyama/$1 [R=301,L]
  RewriteRule ^organizasyonlar/profesyonel-yuz-boyama$ /organizasyonlar/yuz-boyama [R=301,L]
  RewriteRule ^organizasyonlar/profesyonel-makyaj/([a-z0-9-]+)$ /organizasyonlar/yuz-boyama/$1 [R=301,L]
  RewriteRule ^organizasyonlar/profesyonel-makyaj$ /organizasyonlar/yuz-boyama [R=301,L]
  RewriteRule ^organizasyonlar/pamuk-seker-arabasi-kiralama/([a-z0-9-]+)$ /organizasyonlar/pamuk-seker/$1 [R=301,L]
  RewriteRule ^organizasyonlar/pamuk-seker-arabasi-kiralama$ /organizasyonlar/pamuk-seker [R=301,L]
  RewriteRule ^organizasyonlar/dogum-gunu$ /organizasyonlar/dogum-gunu-organizasyonu [R=301,L]
  RewriteRule ^organizasyonlar/dansci-kiralama$ /organizasyonlar/cocuk-etkinlikleri [R=301,L]
  RewriteRule ^organizasyonlar/hostes-kiralama$ /organizasyonlar/cocuk-etkinlikleri [R=301,L]

  # ============================================
  # Static file handling + SPA Fallback
  # ============================================

  # index.html direkt sun
  RewriteRule ^index\.html$ - [L]

  # Sitemap, robots vb.
  RewriteRule \.(xml|txt|webmanifest)$ - [L]

  # Gercek dosya/dizin varsa direkt sun
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # KRITIK: Statik asset uzantili dosyalar bulunamazsa SPA fallback YAPMA
  # Yoksa eski chunk hash'leri index.html olarak donuyor ve browser JS parse hatasi veriyor
  RewriteRule \.(js|css|woff2?|ttf|eot|png|jpe?g|gif|webp|avif|svg|ico|mp4|mov|heic|pdf|json|map|br|gz)$ - [L]

  # Diger tum istekler -> index.html (React Router yonetir)
  RewriteRule ^ /index.html [L]
</IfModule>

# ============================================
# Compressed file headers
# ============================================
<IfModule mod_headers.c>
  <FilesMatch "\.br$">
    Header set Content-Encoding br
    Header set Vary "Accept-Encoding"
  </FilesMatch>
  <FilesMatch "\.js\.br$">
    Header set Content-Type "application/javascript"
  </FilesMatch>
  <FilesMatch "\.css\.br$">
    Header set Content-Type "text/css"
  </FilesMatch>
  <FilesMatch "\.gz$">
    Header set Content-Encoding gzip
    Header set Vary "Accept-Encoding"
  </FilesMatch>
  <FilesMatch "\.js\.gz$">
    Header set Content-Type "application/javascript"
  </FilesMatch>
  <FilesMatch "\.css\.gz$">
    Header set Content-Type "text/css"
  </FilesMatch>
  <FilesMatch "\.html\.gz$">
    Header set Content-Type "text/html"
  </FilesMatch>
</IfModule>

# ============================================
# Compression fallback
# ============================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ============================================
# Browser caching
# ============================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresDefault "access plus 2 days"
</IfModule>

# ============================================
# Security & Cache Headers
# ============================================
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"

  # HTML - asla cache'leme
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Hash'li assets - sonsuza kadar cache'le (immutable)
  <FilesMatch "\.(js|css|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Gorseller
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>

Options -Indexes

<FilesMatch "(^\.env|\.lock$|\.log$|^\.htaccess)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

<FilesMatch "(manifest\.webmanifest|sitemap.*\.xml|robots\.txt)$">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
</FilesMatch>
