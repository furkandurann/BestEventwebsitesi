# Best Event - Apache Server Configuration for React SPA
# Natro Hosting ile uyumlu - Single Page Application (SPA) routing

# ============================================
# MIME Types (AVIF/WebP support)
# ============================================
AddType image/avif .avif
AddType image/webp .webp
AddType application/javascript .js
AddType text/css .css
AddType application/json .json
AddType font/woff2 .woff2
AddType font/woff .woff

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Force Non-WWW (WWW -> Non-WWW Redirect)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # ============================================
  # Pre-compressed file serving (Gzip only - safer for shared hosting)
  # Brotli rewrite removed: Natro shared hosting may not support .br serving
  # ============================================

  # Serve Gzip compressed files if available
  RewriteCond %{HTTP:Accept-Encoding} gzip
  RewriteCond %{REQUEST_FILENAME}.gz -f
  RewriteRule ^(.+)\.(js|css|html|svg|json)$ $1.$2.gz [E=no-gzip:1,L]

  # index.html'i direkt gecir
  RewriteRule ^index\.html$ - [L]

  # Statik dosyalari direkt sun (sitemap, robots, manifest vb.)
  RewriteRule \.(xml|txt|webmanifest)$ - [L]

  # Dosya veya klasor mevcutsa, direkt sun
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Tum diger istekleri index.html'e yonlendir (React Router icin)
  RewriteRule . /index.html [L]
</IfModule>

# ============================================
# Gzip headers for pre-compressed files
# ============================================
<IfModule mod_headers.c>
  # Gzip compressed files
  <FilesMatch "\.gz$">
    Header set Content-Encoding gzip
    Header set Vary "Accept-Encoding"
  </FilesMatch>

  # Correct Content-Type for compressed JS
  <FilesMatch "\.js\.gz$">
    Header set Content-Type "application/javascript"
  </FilesMatch>

  # Correct Content-Type for compressed CSS
  <FilesMatch "\.css\.gz$">
    Header set Content-Type "text/css"
  </FilesMatch>

  # Correct Content-Type for compressed HTML
  <FilesMatch "\.html\.gz$">
    Header set Content-Type "text/html"
  </FilesMatch>
</IfModule>

# ============================================
# Gzip compression (fallback for non-precompressed)
# ============================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ============================================
# Browser caching (aggressive for hashed assets)
# ============================================
<IfModule mod_expires.c>
  ExpiresActive On

  # Images - 1 year (rarely change)
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonts - 1 year (never change)
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # JS/CSS - 1 year (Vite uses content hash, safe to cache forever)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # PDF
  ExpiresByType application/pdf "access plus 1 month"

  # HTML - NO CACHE (index.html must always be fresh)
  ExpiresByType text/html "access plus 0 seconds"

  ExpiresDefault "access plus 2 days"
</IfModule>

# ============================================
# Security & Performance Headers
# ============================================
<IfModule mod_headers.c>
  # Security Headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"

  # Cache Control for HTML - NO CACHE (SPA routing)
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Immutable cache for hashed assets (Vite builds with [hash])
  <FilesMatch "\.(js|css|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Image cache
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>

# ============================================
# Prevent directory browsing
# ============================================
Options -Indexes

# ============================================
# Block access to sensitive files
# ============================================
<FilesMatch "(^\.env|\.lock$|\.log$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# Allow manifest and sitemap
<FilesMatch "(manifest\.webmanifest|sitemap\.xml|robots\.txt)$">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
</FilesMatch>
